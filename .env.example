# EKLAVYA — offline configuration template
# Copy to .env and adjust paths if needed.
# NO cloud API keys required — everything runs locally.

# ── Offline mode ──────────────────────────────────────────────────────────
OFFLINE_MODE=1

# ── Local LLM via Ollama ──────────────────────────────────────────────────
# Requires: ollama pull gemma4:e2b-it-qat
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
OLLAMA_NUM_CTX=8192

# ── Local embeddings (sentence-transformers) ──────────────────────────────
# Run scripts/prefetch_models.py once to download the model before going offline.
EMBED_MODEL=intfloat/multilingual-e5-small
HF_HOME=./models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
