# ── Database (runtime, generated from seed) ───────────────────────────────
data/eklavya.db
data/eklavya.db-shm
data/eklavya.db-wal

# ── LLM disk cache (regenerated by running seed.py) ──────────────────────
data/llm_cache/

# ── Generated / runtime data ─────────────────────────────────────────────
data/archive/
data/portal_published/
data/pdfs_held/
data/manifest.csv

# ── HuggingFace / sentence-transformers model cache ──────────────────────
# (download once with scripts/prefetch_models.py, do not commit ~200 MB)
models/

# ── Seed PDFs — KEEP (tracked, needed to bootstrap the system) ───────────
# data/pdfs_seed/ is intentionally tracked
# data/eval/questions.json is intentionally tracked

